# Notion API
NOTION_TOKEN=secret_xxx
NOTION_PARENT_PAGE_ID=xxx

# Scraping settings
SCRAPE_INTERVAL_MINUTES=60

# Minimum upvotes to include a post (per site)
MIN_UPVOTES_FMKOREA=10
MIN_UPVOTES_DC=5
MIN_UPVOTES_PPOMPPU=5
MIN_UPVOTES_KOREAPAS=3
MIN_UPVOTES_MERBLOG=0
MAX_POSTS_MERBLOG=10
ENABLE_MERBLOG=true

# Optional login cookie for KoreaPas (needed for logged-in access)
KOREAPAS_COOKIE=

# Optional npx path for FM Korea browser challenge bootstrap
NPX_BIN=

# Optional Codex model override for the executive summary section
CODEX_SUMMARY_MODEL=
